// Phase 1 schema: fakt AUTH + IDENTITY.
// Products / Orders abhi Shopify mathi live aave chhe (proxy mode) — etle ahiya
// enu koi table nathi. Phase 2 ma e add thashe, aa schema ne todya vagar.
//
// Design rule: Shopify na IDs ahiya "link" tarike store thay chhe, "identity"
// tarike nahi. Login identity hammesha aapdi potani (Customer.id) chhe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CustomerStatus {
  /// Shopify mathi import thayelo record. Aa vyakti e haju OTP thi potani
  /// identity prove nathi kari — etle aa record thi LOGIN ALLOWED NATHI.
  IMPORTED
  /// OTP verify thai gayo chhe. Login allowed.
  ACTIVE
  /// Aa record bija customer ma merge thai gayo chhe (duplicate Shopify record).
  /// Aa thi login NA thai shake — `mergedIntoId` vaalo record j asli chhe.
  MERGED
  BLOCKED
}

enum IdentifierType {
  PHONE
  EMAIL
}

enum OtpPurpose {
  /// Login / signup
  LOGIN
  /// Already logged-in user bijo email/phone potana account sathe jode
  /// (juna Shopify guest orders ne link karva mate)
  LINK_IDENTITY
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ---------------------------------------------------------------------------
// Customer — aapdi potani login identity (Shopify thi swatantra)
// ---------------------------------------------------------------------------

model Customer {
  id String @id @default(uuid()) @db.Uuid

  /// Normalized E.164 (daa.t. +919876543210). Primary login identifier.
  ///
  /// ⚠️ INVARIANT: aa be fields ma FAKT verified (ke Shopify mathi imported)
  /// values j aave chhe. User e type karelu un-verified value ahiya kyarey
  /// na naakhvu — `resolveOrCreateForLogin()` aa par match kare chhe, etle
  /// koi bija no email ahiya naakhi ne ena account sudhi pahonchi shakay.
  primaryPhone String? @unique
  /// Hammesha lowercase store thay chhe.
  ///
  /// Aa customer no EKMATRA email chhe. Un-verified email kyanya store nathi
  /// thato — app registration ma email maangti j nathi, ane admin pan set
  /// nathi kari shakto. Email fakt OTP verify thay tyare j ahiya aave chhe.
  primaryEmail String? @unique

  firstName String?
  lastName  String?

  /// Screen 36 nu "Additional Information → Gender".
  /// Jaan-bujhi ne enum nahi pan free String — gender na vikalpo desh ane
  /// samay sathe badlaay chhe, ane enum badalvo etle migration. App j nakki
  /// kare ke kaya vikalpo batavvа.
  gender String?

  /// Optional! OTP-only users mate aa null j rahe chhe.
  /// Shopify na password hashes kyarey nathi malta — etle aa aapdo potano chhe.
  passwordHash String?

  status CustomerStatus @default(ACTIVE)

  /// "Primary" Shopify customer — Shopify ma write karta vakhte (order create)
  /// aa vaparvano. Ek vyakti na bija Shopify records ShopifyCustomerLink ma.
  shopifyCustomerId String? @unique

  /// Jyare khabar pade ke aa record ane bijo record ek j vyakti chhe
  /// (daa.t. guest checkout thi banela duplicate), tyare aa juno record
  /// `MERGED` thai ne asli record ne point kare chhe. Delete NA karvu —
  /// orders/audit trail jodayela hoy chhe.
  mergedIntoId String?    @db.Uuid
  mergedInto   Customer?  @relation("CustomerMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Customer[] @relation("CustomerMerge")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  identities     CustomerIdentity[]
  shopifyLinks   ShopifyCustomerLink[]
  refreshTokens  RefreshToken[]
  deviceTokens   DeviceToken[]
  otpCodes       OtpCode[]
  addresses      Address[]
  cart           Cart?
  wishlist       WishlistItem[]
  recentlyViewed RecentlyViewed[]
  notifications  Notification[]

  influencerApplications InfluencerApplication[]
  influencer             Influencer?

  @@index([status])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// CustomerIdentity — VERIFIED contact channels
//
// Aa table j security no paayo chhe: order matching FAKT ahiya na verified
// values par thavu joiye. Un-verified email par match karso to bija na orders
// leak thai jashe.
// ---------------------------------------------------------------------------

model CustomerIdentity {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type  IdentifierType
  /// Normalized: PHONE => E.164, EMAIL => lowercase trimmed
  value String

  verifiedAt DateTime
  isPrimary  Boolean  @default(false)

  createdAt DateTime @default(now())

  /// Ek verified email/phone fakt EK j customer no hoi shake.
  @@unique([type, value])
  @@index([customerId])
  @@map("customer_identities")
}

// ---------------------------------------------------------------------------
// ShopifyCustomerLink — ek vyakti = ghana Shopify customer records
//
// Guest checkout, alag email, POS order — Shopify ma ek j vyakti na 3-4 alag
// customer records hoy chhe. Aa table badha ne ek Customer sathe jode chhe,
// jethi enu AAKHU order history app ma dekhaay.
// Phase 1 ma aa mostly khali rahe; Phase 2 (import) ma bharaay chhe.
// ---------------------------------------------------------------------------

model ShopifyCustomerLink {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Shopify no numeric/gid customer id
  shopifyCustomerId String @unique

  /// 'phone' | 'email' | 'manual' — audit mate: aa link kem banyo
  matchedVia   String
  /// Kaya verified value thi match thayu (audit trail)
  matchedValue String?

  linkedAt DateTime @default(now())

  @@index([customerId])
  @@map("shopify_customer_links")
}

// ---------------------------------------------------------------------------
// OtpCode — code plain ma kyarey store nathi thato (HMAC-SHA256 + pepper)
// ---------------------------------------------------------------------------

model OtpCode {
  id String @id @default(uuid()) @db.Uuid

  identifierType IdentifierType
  /// Normalized identifier
  identifier     String

  /// HMAC-SHA256(code, OTP_PEPPER) — plain code kyarey DB ma nahi
  codeHash String

  purpose OtpPurpose @default(LOGIN)

  /// LINK_IDENTITY mate: kayo logged-in user aa identity claim kare chhe
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  expiresAt  DateTime
  consumedAt DateTime?

  requestIp String?
  createdAt DateTime @default(now())

  @@index([identifier, purpose, expiresAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// RefreshToken — hashed, rotating, reuse-detection sathe
// ---------------------------------------------------------------------------

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// SHA-256(raw token). Raw token fakt client pase j hoy chhe.
  tokenHash String @unique

  /// Rotation family. Ek juno token bije vaar vaparaay (theft signal) to
  /// aakhi family revoke thai jaay chhe.
  familyId String @db.Uuid

  deviceId  String?
  userAgent String?
  ip        String?

  expiresAt    DateTime
  revokedAt    DateTime?
  /// Rotation vakhte aa token ni jagya kayo token e lidhi
  replacedById String?   @db.Uuid

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Address — aapda DB ma, Shopify ma nahi
//
// "Fetch my shipping addresses based on past order" vaalu checkbox aa table
// bhare chhe: user na VERIFIED phone/email na Shopify orders mathi shipping
// addresses kaadhi ne ahiya save thay chhe.
//
// Aa aapdo potano data banii jaay chhe — migration vakhte addresses sathe
// aavse, Shopify par pacha javu nahi pade.
// ---------------------------------------------------------------------------

model Address {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  firstName String?
  lastName  String?
  phone     String?

  line1        String
  line2        String?
  city         String
  province     String?
  provinceCode String?
  zip          String
  country      String
  countryCode  String?

  isDefault Boolean @default(false)

  /// Kaya Shopify order mathi aavyo (audit + debugging). Manually ummerelo
  /// hoy to null.
  importedFromOrder String?

  /// Shopify na customer address book ma aa address no id (numeric, gid nahi).
  /// Aa hoy to update/delete Shopify ma pan pahonche chhe. Null = haju Shopify
  /// sudhi gayo j nathi.
  shopifyAddressId String? @unique

  /// Chhelli vaar kyare Shopify sathe sync thayo. Null hoy ane
  /// `shopifyAddressId` pan null hoy = push baaki chhe (Shopify down hatu,
  /// ke countryCode nahoto malto). Retry aa par thi khabar pade chhe.
  syncedAt DateTime?

  /// Normalized address no hash. Ek j address 15 juna orders ma hoy to pan
  /// ek j vaar save thay — aa vagar user ne 15 same addresses dekhaay.
  fingerprint String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, fingerprint])
  @@index([customerId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// DeviceToken — push notifications (FCM/APNs)
// ---------------------------------------------------------------------------

model DeviceToken {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  platform DevicePlatform
  token    String         @unique
  deviceId String?

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@map("device_tokens")
}

// ---------------------------------------------------------------------------
// Cart — AAPDO POTANO, Shopify ma nahi
//
// Kem aapdo: Shopify no cart Storefront API ma chhe ane e session-based chhe.
// Aapno cart DB ma hoy to user phone badle, app fari install kare, ke web
// parthi aave — cart tya no tya rahe chhe. Ane checkout vakhte j Shopify ne
// mokliye chhiye.
// ---------------------------------------------------------------------------

model Cart {
  id String @id @default(uuid()) @db.Uuid

  /// Ek grahak no ek j cart. (Guest cart aage vadhe tyare aa nullable karvu
  /// padse ane deviceId ummervu — atyare login farjiyat chhe.)
  customerId String   @unique @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Screen 13 no voucher. Ahiya fakt SAACHVIYE chhiye — valid chhe ke nahi
  /// e Shopify j nakki kare chhe, checkout vakhte. Aapne jate discount
  /// KYAREY na ganvo, nahi to app ek rakam batave ane checkout biji.
  discountCode String?

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid

  cartId String @db.Uuid
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  /// Shopify no variant id (numeric, gid nahi). Cart ma AA J asli identifier
  /// chhe — ek j product ni be size alag lines chhe.
  variantId String

  /// Product no handle — app ne product page par lai javu hoy to. Variant id
  /// parthi handle kaadhvo mongho chhe, etle sathe j saachvie chhiye.
  productHandle String

  quantity Int

  /// ⚠️ AA FIELDS FAKT DEKHAADVA MATE CHHE — bhaav no faislo aa nathi.
  ///
  /// Cart kholo etle turat kai batavvu pade, ane dar item mate Shopify ne
  /// puchhvu bahu mongu chhe. Etle add karti vakhte ni nakal ahiya rakhiye
  /// chhiye.
  ///
  /// Asli bhaav Shopify checkout ganse. Product mirror (Phase 2) aavi jaay
  /// pachhi GET /cart ee Product table sathe join karse ane aa fields fakt
  /// fallback rahese.
  title         String
  variantTitle  String?
  imageUrl      String?
  priceAmount   String
  priceCurrency String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// E j variant fari add thay to navi line nahi — quantity vadhe chhe
  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Wishlist ane RecentlyViewed — Shopify ma aa concept j nathi
// ---------------------------------------------------------------------------

model WishlistItem {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Handle j raakhiye chhiye, variant nahi — user ne "aa dress gami" chhe,
  /// "aa dress size M ma" nahi.
  productHandle String

  createdAt DateTime @default(now())

  @@unique([customerId, productHandle])
  @@index([customerId])
  @@map("wishlist_items")
}

model RecentlyViewed {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productHandle String

  /// Fari joyu to navi row nahi — aa j update thay chhe (juo @@unique)
  viewedAt DateTime @default(now())

  @@unique([customerId, productHandle])
  @@index([customerId, viewedAt])
  @@map("recently_viewed")
}

// ---------------------------------------------------------------------------
// INFLUENCER PROGRAM — Phase 1: application flow
//
// Design rule: influencer e ALAG account NATHI. E j Customer chhe, jene ek
// vadharani bhumika mali chhe. Etle `Influencer` row `Customer` ni upar
// hangs — koi bijo login nathi, koi bija tokens nathi, ane grahak vaala
// badha endpoints ene em na em chale chhe.
// ---------------------------------------------------------------------------

enum InfluencerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InfluencerStatus {
  /// Approve thayelo — reels muki shake ane coins kamai shake
  ACTIVE
  /// Admin e rokyo — juna reels feed ma thi nikdi jaay chhe ane navu earning
  /// band. Wallet no baaki balance rahe chhe (kamayelu paisa chhe, saja nahi).
  SUSPENDED
}

model InfluencerApplication {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// "@priya.styles" — @ vagar store thay chhe, normalize kari ne
  socialHandle   String
  /// Platform: instagram | youtube | facebook — free String, karan ke aavti
  /// kaale koi navu platform aavse ane enum badalvo etle migration.
  socialPlatform String
  /// Applicant e potej kahelo aankdo — VERIFIED NATHI. Admin e jate profile
  /// kholi ne joi levu. Fakt queue sort karva mate kaam nu chhe.
  followerCount  Int

  /// Payout mate India ma jaruri chhe. ⚠️ Aa PII chhe — response ma hammesha
  /// masked j jaay chhe (juo InfluencerMapper), aakho kyarey nahi.
  panNumber String

  status InfluencerApplicationStatus @default(PENDING)

  /// Reject nu kaaran applicant ne dekhaay chhe, etle vaanchvаa layak lakhvu.
  rejectionReason String?
  /// Kayo admin e nirnay lidho. Single-admin setup chhe etle atyare hammesha
  /// e j email — pan multi-admin aave tyare aa column pehla thi taiyar chhe.
  reviewedBy      String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⚠️ Ek grahak ni EK j PENDING application hovi joiye.
  ///
  /// Postgres ma partial unique index Prisma schema thi nathi thato, etle e
  /// migration ma hathe lakhyo chhe (juo migration.sql). Aa index vagar user
  /// "Apply" be vaar dabaave to be rows bane chhe ane admin ne duplicate
  /// queue ma dekhaay chhe.
  @@index([customerId])
  @@index([status, createdAt])
  @@map("influencer_applications")
}

model Influencer {
  id String @id @default(uuid()) @db.Uuid

  /// EK grahak = EK influencer. Aa unique j aa aakha design nu paayu chhe.
  customerId String   @unique @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Kai application par thi aa banyo — audit mate
  applicationId String @unique @db.Uuid

  socialHandle   String
  socialPlatform String

  status InfluencerStatus @default(ACTIVE)

  /// Suspend nu kaaran — admin ne pachhi yaad rahetu nathi ke kem karyu hatu
  suspendedReason String?
  suspendedAt     DateTime?

  approvedAt DateTime @default(now())
  approvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("influencers")
}

// ===========================================================================
// APP CONTENT (CMS) — Shopify ma aa kai j nathi
//
// Shopify pase products ane orders chhe, pan mobile app na home screen nu
// banner, section nu order, "About us" nu majkur, FAQ — aa badhu enu vishay
// j nathi. Etle aa aapdu potanu chhe, ane Phase 2 pachhi pan aapdu j rahese.
//
// ⚠️ Ek niyam: aa tables ma KYAREY bhaav, stock ke product no data nakal na
// karvo. Ahiya fakt "kayo product batavvo" (handle) rahe chhe — "e ketla no
// chhe" e hammesha Shopify/Products layer j kahe chhe. Nakal karso to ek din
// app ma ₹1,200 ane checkout ma ₹1,500 dekhaashe.
// ===========================================================================

enum BannerLinkType {
  /// Banner par tap kariye to kai na thay (fakt visual)
  NONE
  /// linkValue = product no handle
  PRODUCT
  /// linkValue = collection no handle
  COLLECTION
  /// linkValue = aakhu URL (in-app browser ma khule)
  URL
}

model Banner {
  id String @id @default(uuid()) @db.Uuid

  title    String
  imageUrl String
  /// Image na aave tyare ane screen-reader mate
  alt      String?

  linkType  BannerLinkType @default(NONE)
  linkValue String?

  /// Kaya screen par — "home", "cart", "category" vagere. Enum jaan-bujhi ne
  /// nathi: navi jagya e banner mukvo hoy tyare migration na joiye.
  placement String @default("home")

  /// Nano number pehla dekhaay
  position Int     @default(0)
  isActive Boolean @default(true)

  /// Sale na banners — jaate on/off thay chhe. Null = koi seema nahi.
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, position])
  @@map("banners")
}

enum HomeSectionType {
  /// `reference` = banner placement
  BANNER_CAROUSEL
  /// `reference` = collection no handle
  COLLECTION_ROW
  /// `productHandles` = jate pasand karela products (aa j order ma)
  PRODUCT_GRID
  /// Badhi collections ni grid (categories screen jevu)
  CATEGORY_GRID
}

/// Home screen nu layout — app hard-coded nathi, aa table j nakki kare chhe.
/// Etle "aa mahine banner upar, next mahine bestsellers upar" mate app na
/// navu version ni jarur nathi.
model HomeSection {
  id String @id @default(uuid()) @db.Uuid

  type     HomeSectionType
  title    String?
  subtitle String?

  reference      String?
  productHandles String[]

  /// Section ma vadhu ma vadhu ketli items
  itemLimit Int @default(10)

  position Int     @default(0)
  isActive Boolean @default(true)

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("home_sections")
}

/// About us, Terms, Privacy, Return policy — app ma static screens
model Page {
  id String @id @default(uuid()) @db.Uuid

  /// "about-us", "terms", "privacy", "return-policy"
  slug  String @unique
  title String
  /// Markdown ke HTML — app kayo format vaanche e app nakki kare
  body  String

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

model Faq {
  id String @id @default(uuid()) @db.Uuid

  question String
  answer   String
  /// "Orders", "Shipping", "Returns" — app ma group karva mate
  category String?

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("faqs")
}

/// App ma "available offers" ma dekhaadva na coupons.
///
/// ⚠️ AA COUPON BANAVTU NATHI. Discount code Shopify ma j bane chhe ane
/// valid chhe ke nahi e Shopify checkout j nakki kare chhe. Aa table fakt
/// "grahak ne kaya codes batavva" nu list chhe. Ahiya code lakhi devathi e
/// kaam karto nathi thai jato — Shopify ma pan e j code hovo joiye.
model AppCoupon {
  id String @id @default(uuid()) @db.Uuid

  /// Shopify no discount code, jem no tem
  code        String  @unique
  title       String
  description String?
  imageUrl    String?
  /// "₹2,000 thi upar na order par" — fakt dekhaadva mate
  terms       String?

  position Int     @default(0)
  isActive Boolean @default(true)

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("app_coupons")
}

// ===========================================================================
// PUSH NOTIFICATIONS
//
// `DeviceToken` pehla thi chhe (app token register kare chhe). Aa tables e
// batave chhe ke kone, kyare, su mokalyu — ane sauthi vadhu jaruri: **su
// nishfal gayu**.
// ===========================================================================

enum NotificationAudience {
  /// Jena pase push token chhe eva badha
  ALL
  /// `segment` field pramane
  SEGMENT
  /// Ek j grahak — support na javaab mate
  CUSTOMER
}

/// Segments ne enum rakhya chhe (banner na placement thi ultu) karan ke dar
/// segment ni pachhal ek query chhe je code ma lakhelii chhe. Free string
/// rakhiye to admin evu segment lakhi shake je code ne oLakhaatu j nathi,
/// ane campaign chup-chaap 0 loko sudhi jaay.
enum NotificationSegment {
  ALL_USERS
  /// Cart bharelu chhe pan 24 kalak thi shaant chhe
  ABANDONED_CART
  /// Wishlist ma kaik chhe
  HAS_WISHLIST
  /// 30 divas thi login nathi karyu
  INACTIVE_30D
  /// Chhella 7 divas ma joined
  NEW_LAST_7D
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  /// Atyare mokalvani prakriya chalu chhe — aa status j be vaar mokalvani
  /// bhool rokato taalo chhe (juo `dispatchDue`)
  SENDING
  SENT
  FAILED
  CANCELLED
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  title String
  body  String

  /// App ma kya lai javu: "product:blue-saree", "collection:sarees",
  /// "order:PBG1036", "url:https://..." — parse app kare chhe.
  deepLink String?
  imageUrl String?

  audience NotificationAudience @default(ALL)
  segment  NotificationSegment?

  /// audience = CUSTOMER hoy tyare
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  status      NotificationStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  /// Ketla devices ne target karya / pahonchyu / nishfal
  totalTargets Int @default(0)
  sentCount    Int @default(0)
  failedCount  Int @default(0)

  /// Aakhu campaign fail thay tyare no karan (dar device no nahi)
  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDelivery[]

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@map("notifications")
}

/// FAKT NISHFAL delivery o ahiya lakhaay chhe.
///
/// 40,000 users na broadcast ma 40,000 "sent" rows lakhvi e ek j campaign ma
/// aakhu table fulaavi de chhe, ane e rows koi kyarey vaanchtu nathi. Safal
/// no aankdo `Notification.sentCount` ma chhe — ee j puratu chhe. Ahiya e j
/// aave chhe jene khabar padvi jaruri chhe: kayo token bagdyo ane kem.
model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid

  notificationId String       @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  customerId String? @db.Uuid

  platform     DevicePlatform
  /// Token no chhello bhaag j — aakho token log ma kyarey na jaay
  tokenPreview String

  error    String
  failedAt DateTime @default(now())

  @@index([notificationId])
  @@map("notification_deliveries")
}

/// Vaar vaar mokalvana messages — "Order shipped", "Sale live"
model NotificationTemplate {
  id String @id @default(uuid()) @db.Uuid

  name  String @unique
  title String
  body  String

  deepLink String?
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

// ===========================================================================
// AUDIT LOG
//
// Ek j admin chhe, etle "kone karyu?" no sawaal atyare nano chhe. Pan
// "**kyare** ane **su** badlyu" no sawaal moto chhe: grahak fariyad kare ke
// "mane block kem karyo" ke "mari wishlist kya gai", tyare aa ek j jagya chhe
// jya javaab male chhe.
//
// FK jaan-bujhi ne nathi — je record delete ke merge thai gayo hoy eno itihaas
// pan rehvo joiye.
// ===========================================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// "customer.block", "customer.merge", "banner.delete", "notification.send"
  action String

  /// "customer", "banner", "notification", "system"
  entityType String
  entityId   String?

  /// Ek line ma mansa — panel ni list ma aa j dekhaay chhe
  summary String

  /// Fakt badlayela fields. Aakho record nakal na karvo — enathi juna
  /// phone/email na hamesha maate copies bani jaay chhe.
  before Json?
  after  Json?

  /// Admin no email. ADMIN_EMAIL badlaay to pan itihaas ma juno j rahe.
  actor String
  ip    String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}
