# ---------- App ----------
NODE_ENV=development
# 3000 aa machine par bija process e lidho chhe
PORT=3001
API_PREFIX=api/v1

# ---------- Database ----------
# Host port 5434 (5432 machine na native Postgres e lidho chhe)
DATABASE_URL="postgresql://abd:abd_local_pw@localhost:5434/abd_ecomm?schema=public"

# ---------- Redis ----------
# Host port 6380 (6379 machine par bija project e lidho chhe)
REDIS_URL="redis://localhost:6380"

# ---------- JWT ----------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long-value"
JWT_ACCESS_TTL=900              # 15 minutes (seconds)
JWT_ISSUER=abd-ecomm-api
REFRESH_TOKEN_TTL_DAYS=60

# ---------- OTP ----------
OTP_PROVIDER=console            # console | msg91 | twilio
OTP_LENGTH=6
OTP_TTL_SECONDS=300             # 5 minutes
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_IDENTIFIER_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
# HMAC pepper used to hash OTP codes at rest. Rotate = all pending OTPs invalid.
OTP_PEPPER="change-me-otp-pepper-min-32-chars-long-value"
# Dev only: returns the OTP in the API response so you can test without SMS.
OTP_EXPOSE_IN_RESPONSE=true
# NODE_ENV=production vaali deploy par upar valu kholva de chhe (staging mate).
# Real users aave e pehla aa kaadhi naakhvu — nahitar gme te account hack thai shake.
ALLOW_OTP_EXPOSE_IN_PROD=false

# ---------- Defaults ----------
DEFAULT_COUNTRY_CODE=IN

# ---------- Shopify (Phase 1 - proxy mode; auth module ne aani jarur nathi) ----------
SHOPIFY_STORE_DOMAIN=""

# Latest stable. Shopify dar quarter navu version kaadhe chhe (2026-10 next).
# Version hammesha explicitly pin karvu — "latest" kyarey na vaparvu.
SHOPIFY_API_VERSION=2026-07

# Dev Dashboard app na credentials (app ni Settings tab ma).
# 1 Jan 2026 thi legacy custom apps band chhe, etle static shpat_ token nathi
# malto. Aa be thi client_credentials grant kari ne token levo pade chhe:
#   POST https://{shop}.myshopify.com/admin/oauth/access_token
# Token 24 kalak chale chhe — app e ene cache ane auto-refresh karvo pade.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""

# App ma signup thay etle Shopify ma pan customer banaavvo?
#   true  = app no user Shopify admin ma dekhaay ("mobile-app" tag sathe), ane
#           email verify thay pachhi website par pan login kari shake
#   false = Shopify ma fakt tyare bane jyare kharekhar order thay
SHOPIFY_CREATE_CUSTOMER_ON_SIGNUP=true

# ---------- Product source (Phase 2 no switch) ----------
# shopify = live Shopify API (Phase 1)
# db      = Postgres (Phase 2, DbProductRepository lakhya pachhi)
PRODUCT_SOURCE=shopify
PRODUCT_LIST_CACHE_TTL=300      # seconds
PRODUCT_DETAIL_CACHE_TTL=180
# Collections ochha badlaay chhe, etle TTL lambo
COLLECTION_LIST_CACHE_TTL=600
COLLECTION_DETAIL_CACHE_TTL=600

# Orders na status badlaay chhe (Unfulfilled → Fulfilled, tracking number)
# etle TTL tunko j — cache fakt Shopify na rate limit mate chhe.
ORDER_LIST_CACHE_TTL=60

# Storefront API token — cart/checkout mate (Admin credentials thi ALAG).
# `storefrontAccessTokenCreate` mutation thi bane chhe. Expire nathi thato.
SHOPIFY_STOREFRONT_TOKEN=""

# ---------- Admin panel ----------
# EK j admin user chhe — roles nathi, admin-users table nathi.
# ADMIN_EMAIL khaali rakho etle aakhu /admin/* band rahe chhe.
ADMIN_EMAIL="admin@yourstore.com"

# Password hash banaavo:  npm run admin:hash -- "your-password"
ADMIN_PASSWORD_HASH=""

# Fakt local dev mate — plain password, hash vagar.
# Production ma aa set hoy to app boot j nahi thay.
ADMIN_PASSWORD="change-me-local-only"

# ⚠️ JWT_ACCESS_SECRET thi ALAG j hovo joiye, nahi to grahak no token
# admin routes par pan chaali jaay chhe.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ADMIN_SECRET="change-me-admin-secret-min-32-chars-long-value"
JWT_ADMIN_TTL=28800             # 8 hours (refresh token nathi)

# Aatla khota password pachhi e IP par thi login lock
ADMIN_MAX_LOGIN_ATTEMPTS=10
ADMIN_LOGIN_LOCK_SECONDS=900    # 15 minutes

# ---------- App content (CMS) ----------
# Home layout, banners, pages, FAQ — mahine ek vaar badlaay chhe, etle TTL
# lambo. Admin panel ma save karo etle cache jate saaf thai jaay chhe.
CONTENT_CACHE_TTL=600

# ---------- Push notifications ----------
# console = terminal ma print (dev, Firebase project ni jarur nathi)
# fcm     = Firebase Cloud Messaging
# ⚠️ Production ma `console` rehi jaay to campaigns "sent" dekhaashe pan koi
# na phone par kai nahi jaay — ane koi error pan nahi aave.
PUSH_PROVIDER=console

# PUSH_PROVIDER=fcm mate — service account nu aakhu JSON, ek line ma
FCM_SERVICE_ACCOUNT_JSON=""

# Ek batch ma ketla devices. FCM ni potani had 500 ni chhe.
PUSH_BATCH_SIZE=100
